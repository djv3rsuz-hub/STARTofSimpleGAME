<Window x:Class="SimpleWPFGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple WPF Game" 
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="#FF0A0A1A"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Height="50" Background="#FF0D1117">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="SIMPLE WPF GAME" 
                       FontSize="18" FontWeight="Bold"
                       Foreground="#FF00D4FF" VerticalAlignment="Center" Margin="20,0"/>
            
            <TextBlock Grid.Column="1" x:Name="FpsDisplay" Text="FPS: 0" 
                       FontSize="16" FontWeight="Bold"
                       Foreground="#FF00FF88" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            
            <TextBlock Grid.Column="2" x:Name="ControllerDisplay" Text="No Controller" 
                       FontSize="14"
                       Foreground="#FFFF6B6B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
        </Grid>

        <!-- Game Area Container -->
        <Grid Grid.Row="1" Background="#FF0A0A1A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="1280"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="#FF0D1117">
                <StackPanel VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="CONTROLS" Foreground="#FF00D4FF" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    <TextBlock Text="W/A/S/D or Arrows" Foreground="#FF888888" FontSize="12"/>
                    <TextBlock Text="Move Blue Cube" Foreground="#FF666666" FontSize="11" Margin="0,0,0,10"/>
                    <TextBlock Text="Controller: Left Stick" Foreground="#FF888888" FontSize="12"/>
                    <TextBlock Text="or D-Pad" Foreground="#FF666666" FontSize="11" Margin="0,0,0,10"/>
                    <Separator Background="#FF222222" Margin="0,5"/>
                    <TextBlock x:Name="InputStatusText" Text="Input: Keyboard" 
                               Foreground="#FF00FF88" FontSize="12" Margin="0,10,0,0"/>
                    <TextBlock x:Name="CubePositionText" Text="Position: 0, 0" 
                               Foreground="#FF666666" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Game Screen (1280x720) -->
            <Border Grid.Column="1" x:Name="GameScreenBorder" 
                    BorderBrush="#FF00D4FF" BorderThickness="1" 
                    ClipToBounds="True" Background="Black">
                <Canvas x:Name="GameCanvas" Width="1280" Height="720"/>
            </Border>

            <!-- Right Sidebar -->
            <Border Grid.Column="2" Background="#FF0D1117">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>

                    <!-- Debug Info -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,0">
                        <TextBlock Text="DEBUG INFO" Foreground="#FF00D4FF" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ObjectCountText" Text="Objects: 0" Foreground="#FF888888" FontSize="12"/>
                        <TextBlock x:Name="EngineStatusText" Text="Engine: Ready" Foreground="#FF888888" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="ControllerButtonText" Text="Controller: None" Foreground="#FF888888" FontSize="12" Margin="0,3,0,0"/>
                        <TextBlock x:Name="CollisionDebugText" Text="Collision: OFF [F3]" Foreground="#FF666666" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#FF222222" Margin="15,8"/>

                    <!-- Debug Console -->
                    <Grid Grid.Row="2" Margin="15,5,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="DEBUG CONSOLE" Foreground="#FF00D4FF" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>

                        <!-- Console output -->
                        <Border Grid.Row="1" Background="#FF0A0E14" BorderBrush="#FF222222" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto" Padding="4">
                                <TextBlock x:Name="ConsoleOutput" Text="" Foreground="#FF00FF88" FontSize="10"
                                           TextWrapping="Wrap" FontFamily="Consolas"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Console input -->
                    <Grid Grid.Row="3" Margin="15,5,15,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ConsoleInput" Grid.Column="0"
                                 Background="#FF0A0E14" Foreground="#FF00FF88"
                                 FontFamily="Consolas" FontSize="11"
                                 BorderBrush="#FF00D4FF" BorderThickness="1"
                                 Padding="4,2" VerticalContentAlignment="Center"
                                 KeyDown="ConsoleInput_KeyDown"
                                 ToolTip="Type commands: help, collision, fps, objects, clear"/>
                        <Button Grid.Column="1" Content="&#x27A4;" 
                                Width="28" Margin="4,0,0,0"
                                Background="#FF00D4FF" Foreground="#FF0A0E14"
                                FontWeight="Bold" FontSize="14"
                                Click="ConsoleSend_Click"
                                ToolTip="Send command"/>
                    </Grid>

                    <Separator Grid.Row="4" Background="#FF222222" Margin="15,8"/>

                    <!-- Log -->
                    <Grid Grid.Row="5" Margin="15,5,15,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LOG" Foreground="#FF00D4FF" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <Border Grid.Row="1" Background="#FF0A0E14" BorderBrush="#FF222222" BorderThickness="1" CornerRadius="3">
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="4">
                                <TextBlock x:Name="LogDisplay" Text="" Foreground="#FF666666" FontSize="9"
                                           TextWrapping="Wrap" FontFamily="Consolas"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Grid Grid.Row="2" Height="30" Background="#FF0D1117">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready" 
                       Foreground="#FF666666" FontSize="12" VerticalAlignment="Center" Margin="15,0"/>
            
            <TextBlock Grid.Column="1" x:Name="TimeDisplay" Text="00:00:00" 
                       Foreground="#FF666666" FontSize="12" VerticalAlignment="Center"/>
            
            <TextBlock Grid.Column="2" x:Name="WindowSizeText" Text="1600x900 | 1280x720" 
                       Foreground="#FF666666" FontSize="12" VerticalAlignment="Center" 
                       HorizontalAlignment="Right" Margin="0,0,15,0"/>
        </Grid>
    </Grid>
</Window>
